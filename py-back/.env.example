DJANGO_SECRET_KEY=replace-with-a-long-random-secret
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_DB_NAME=db.sqlite3
DJANGO_USE_PHP_DATABASE=false
DJANGO_CORS_ALLOWED_ORIGINS=http://127.0.0.1:8080,http://localhost:8080,https://mateablemedia.com,https://www.mateablemedia.com
PHP_SESSION_COOKIE_NAME=PHPSESSID

# Set DJANGO_USE_PHP_DATABASE=true to read/write the PHP tournaments tables.
# Copy the corresponding values from the PHP site's .env; do not commit secrets.
DB_NAME=
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=
DB_PASSWORD=